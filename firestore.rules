rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profilleri - sadece kendi profilini okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kayıtlar (records)
    match /records/{recordId} {
      // Okuma: sadece kendi kayıtlarını okuyabilir
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Oluşturma: giriş yapmış kullanıcı kendi userId'si ile kayıt oluşturabilir
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Güncelleme: sadece kendi kaydını güncelleyebilir
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Silme: sadece kendi kaydını silebilir
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

  }
}
